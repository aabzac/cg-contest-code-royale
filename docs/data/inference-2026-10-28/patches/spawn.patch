+    /**
+     * Compares only the creeps registered in this frame (creation order) with the last creeps of
+     * the same player's block in the simulation (insertion order).
+     */
+    static void compareNew(Result res, GameState s, CgReplay.View v, Units units, long gameId, int tn) {
+        List<String> repNew = new ArrayList<>(), simNew = new ArrayList<>();
+        StringBuilder b = new StringBuilder();
+        boolean allNew = true;
+        for (int p = 0; p < 2; p++) {
+            List<Integer> ids = new ArrayList<>();
+            for (Map.Entry<Integer, JsonObject> e : v.registered.entrySet()) {
+                String ty = e.getValue().has("type") ? e.getValue().get("type").getAsString() : "";
+                if (ty.equals("Site") || ty.equals("Queen")) continue;
+                if (units.owner.get(e.getKey()) == p) ids.add(e.getKey());
+            }
+            if (ids.isEmpty()) continue;
+            ids.sort(null);
+            List<Integer> sim = new ArrayList<>();
+            for (int i = 0; i < s.nCreeps; i++) if (s.cOwner[i] == p) sim.add(i);
+            res.newGroups++;
+            boolean all = true;
+            for (int k = 0; k < ids.size(); k++) {
+                int id = ids.get(k);
+                List<String> t = units.texts.get(id - 2);
+                String hp = t == null || t.isEmpty() ? "?" : t.get(0).replace("Health: ", "");
+                String rep = p + " " + units.type.get(id) + " " + units.x.get(id) + " " + units.y.get(id) + " " + hp;
+                int si = sim.size() - ids.size() + k;
+                String got = si < 0 ? "none" : p + " " + Const.CREEP_NAME[s.cType[sim.get(si)]] + " " + Math.round(s.cx[sim.get(si)]) + " " + Math.round(s.cy[sim.get(si)]) + " " + s.cHp[sim.get(si)];
+                repNew.add(rep);
+                simNew.add(got);
+                res.newCreeps++;
+                if (rep.equals(got)) res.newCreepsExact++;
+                else all = false;
+                b.append(" [").append(rep).append(" | ").append(got).append(']');
+            }
+            if (all) res.newGroupsExact++;
+            else allNew = false;
+        }
+        // Pre-existing units: everything except the creeps registered in this frame.
+        List<String> repOld = units.alive(), simOld = simUnits(s);
+        for (String x : repNew) repOld.remove(x);
+        for (String x : simNew) simOld.remove(x);
+        boolean oldOk = repOld.equals(simOld);
+        res.spawnClass.merge((oldOk ? "oldOk" : "oldBad") + "/" + (allNew ? "newOk" : "newBad"), 1, Integer::sum);
+        if (!allNew && Boolean.getBoolean("logNew"))
+            System.out.println("NEW g" + gameId + " t" + tn + (oldOk ? " OLD-OK" : " old-bad " + diff(repOld, simOld)) + " replay|sim" + b);
+    }
