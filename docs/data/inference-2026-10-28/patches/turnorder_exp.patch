+    /** Compares the simulated tower shots and knight hits of the last resolve with the replay frame. */
+    static void compareEvents(Result res, Events ev, Rules rules, GameState s, long gameId, int tn, boolean posOk, StringBuilder out) {
+        Map<Integer, Integer> simBySite = new HashMap<>();
+        for (int k = 0; k < rules.nShots; k++) simBySite.put(rules.shotSite[k], k);
+        java.util.Set<Integer> sites = new java.util.TreeSet<>(simBySite.keySet());
+        sites.addAll(ev.shots.keySet());
+        for (int site : sites) {
+            Integer k = simBySite.get(site);
+            String sfx = (posOk ? "@posOk" : "") + (k != null && rules.shotNewborn[k] ? "@newborn" : "");
+            double[] r = ev.shots.get(site);
+            double srcX = s.sx[site], srcY = s.sy[site] - s.sr[site] * 0.6;
+            String desc;
+            if (k == null) { res.events.merge("shot replayOnly" + sfx, 1, Integer::sum); desc = "replayOnly"; }
+            else if (r == null && s.stType[site] != Const.TOWER) {
+                // The tower died in its own act: Obstacle.act updates the entities after the structure is gone,
+                // so the projectile of its last shot is never drawn.
+                res.events.merge("shot simOnly towerDied" + sfx, 1, Integer::sum); desc = "simOnlyTowerDied";
+            }
+            else if (r == null) { res.events.merge("shot simOnly" + sfx, 1, Integer::sum); desc = "simOnly"; }
+            else {
+                double tx = rules.shotX[k], ty = rules.shotY[k];
+                double px = rules.shotPostX[k], py = rules.shotPostY[k];
+                if (Math.abs(px - tx) + Math.abs(py - ty) > 1e-9) {
+                    // Target moved after the shot (spawn collisions): which position does the replay projectile point at?
+                    double lenPre = Math.sqrt(Physics.distSq(tx, ty, srcX, srcY)), lenPost = Math.sqrt(Physics.distSq(px, py, srcX, srcY));
+                    String which = Math.abs(lenPre - r[2]) < 2e-3 ? "pre" : (Math.abs(lenPost - r[2]) < 2e-3 ? "post" : "neither");
+                    res.events.merge("movedTarget " + which, 1, Integer::sum);
+                }
+                int mx = (int) ((srcX + tx) / 2.0), my = (int) ((srcY + ty) / 2.0);
+                double len = Math.sqrt(Physics.distSq(tx, ty, srcX, srcY));
+                boolean sameMid = Math.abs(mx - r[0]) <= 1 && Math.abs(my - r[1]) <= 1;
+                if (sameMid && Math.abs(len - r[2]) < 2e-3) { res.events.merge("shot exact" + sfx, 1, Integer::sum); continue; }
+                if (sameMid && Math.abs(len - r[2]) < 3) { res.events.merge("shot near" + sfx, 1, Integer::sum); desc = "near"; }
+                else { res.events.merge("shot otherTarget" + sfx, 1, Integer::sum); desc = "otherTarget"; }
+            }
+            if (out != null) {
+                out.append(String.format(java.util.Locale.ROOT, "SHOT g%d t%d site%d %s%s", gameId, tn, site, desc, sfx));
+                if (k != null) out.append(String.format(java.util.Locale.ROOT, " sim->%s(%.3f,%.3f) hp%d dmg%d len%.4f", rules.shotQueen[k] ? "Q" : "c",
+                    rules.shotX[k], rules.shotY[k], rules.shotHp[k], rules.shotDmg[k], Math.sqrt(Physics.distSq(rules.shotX[k], rules.shotY[k], srcX, srcY))));
+                if (r != null) out.append(String.format(java.util.Locale.ROOT, " rep->(%.1f..%.1f,%.1f..%.1f) len%.4f", 2 * r[0] - srcX, 2 * r[0] + 2 - srcX,
+                    2 * r[1] - srcY, 2 * r[1] + 2 - srcY, r[2]));
+                out.append('\n');
+            }
+        }
+        String sfx = posOk ? "@posOk" : "";
+        // Queen shots per attacked player: replay targets within 3 units of the replay queen position.
+        ev.qShots[0] = ev.qShots[1] = 0;
+        ev.simQShots[0] = ev.simQShots[1] = 0;
+        for (int k = 0; k < rules.nShots; k++) {
+            if (!rules.shotQueen[k]) continue;
+            int p = Math.abs(rules.shotX[k] - s.qx[0]) < 1e-9 && Math.abs(rules.shotY[k] - s.qy[0]) < 1e-9 ? 0 : 1;
+            ev.simQShots[p]++;
+        }
+        for (Map.Entry<Integer, double[]> e : ev.shots.entrySet()) {
+            int site = e.getKey();
+            double[] r = e.getValue();
+            double srcX = s.sx[site], srcY = s.sy[site] - s.sr[site] * 0.6;
+            double tx = 2 * r[0] + 1 - srcX, ty = 2 * r[1] + 1 - srcY;
+            for (int p = 0; p < 2; p++)
+                if (ev.queenX[p] != null && Math.abs(tx - ev.queenX[p]) <= 3 && Math.abs(ty - ev.queenY[p]) <= 3) ev.qShots[p]++;
+        }
+        for (int p = 0; p < 2; p++) {
+            if (rules.knightHits[p] == ev.hits[p]) res.events.merge("knightHits same" + sfx, 1, Integer::sum);
+            else {
+                res.events.merge("knightHits diff" + sfx, 1, Integer::sum);
+                if (out != null) out.append(String.format("HITS g%d t%d queen%d sim%d rep%d%s%n", gameId, tn, p, rules.knightHits[p], ev.hits[p], sfx));
+            }
+        }
+    }
