+                assertEquals(120, s.gold[1]);
+                assertTrue(s.barrTraining[3]);
+            }
+        }
+    }
+
+    @Test
+    void liveUnitCapWarnsOnEmptyTrain() {
+        GameState s = emptyState();
+        for (int i = 0; i < 31; i++) s.addCreep(1, Const.KNIGHT, 1700, 100 + 25 * i);
+        Rules r = new Rules();
+        r.resolve(s, Command.waitCmd(), Command.waitCmd());
+        assertEquals("Training too many creeps (31 total units requested; 30 maximum)", r.lastWarning[1]);
+    }
+
+    /** Barracks at site 2 completes next to an enemy tower at site 18: towers act before spawning. */
+    @Test
+    void liveTowersShootBeforeBarracksSpawn() {
+        GameState s = emptyState();
+        s.stType[18] = Const.TOWER; s.stOwner[18] = 0; s.towerHp[18] = 800; s.towerRange[18] = 510;
+        s.stType[2] = Const.BARRACKS; s.stOwner[2] = 1; s.barrType[2] = Const.KNIGHT;
+        s.barrTraining[2] = true; s.barrProgress[2] = Const.CREEP_BUILD_TIME[Const.KNIGHT] - 1;
+        new Rules().resolve(s, Command.waitCmd(), Command.waitCmd());
+        assertEquals(4, s.nCreeps);
+        for (int i = 0; i < 4; i++) assertEquals(Const.CREEP_HP[Const.KNIGHT], s.cHp[i], "spawned creep " + i + " shot");
+    }
 }
