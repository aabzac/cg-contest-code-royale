+    /** Knight barracks of player 1 at site 4 completing this turn; player 0 tower at site 23 covering the map. */
+    private static GameState spawnUnderTower() {
+        GameState s = emptyState();
+        s.stType[4] = Const.BARRACKS; s.stOwner[4] = 1; s.barrType[4] = Const.KNIGHT;
+        s.barrTraining[4] = true; s.barrProgress[4] = Const.CREEP_BUILD_TIME[Const.KNIGHT] - 1;
+        s.stType[23] = Const.TOWER; s.stOwner[23] = 0; s.towerHp[23] = 800; s.towerRange[23] = 2000;
+        return s;
+    }
+
+    @Test
+    void towersActBeforeBarracksSpawn() {
+        boolean saved = Rules.STRUCTURES_BY_TYPE;
+        try {
+            Rules.STRUCTURES_BY_TYPE = true;
+            GameState s = spawnUnderTower();
+            int queenHp = s.hp[1];
+            new Rules().resolve(s, Command.waitCmd(), Command.waitCmd());
+            assertEquals(4, s.nCreeps);
+            for (int i = 0; i < s.nCreeps; i++) assertEquals(Const.CREEP_HP[Const.KNIGHT], s.cHp[i], "creep spawned this turn was shot or aged");
+            assertTrue(s.hp[1] < queenHp, "the tower shoots the queen: no creep exists when it acts");
+
+            Rules.STRUCTURES_BY_TYPE = false;  // repository: site order, site 23 acts after the spawn
+            s = spawnUnderTower();
+            new Rules().resolve(s, Command.waitCmd(), Command.waitCmd());
+            int shot = 0;
+            for (int i = 0; i < s.nCreeps; i++) if (s.cHp[i] < Const.CREEP_HP[Const.KNIGHT]) shot++;
+            assertEquals(1, shot);
+        } finally {
+            Rules.STRUCTURES_BY_TYPE = saved;
+        }
+    }
+
+    private static boolean trainAccepted(int alive) {
+        GameState s = emptyState();
+        s.stType[4] = Const.BARRACKS; s.stOwner[4] = 0; s.barrType[4] = Const.KNIGHT;
+        for (int i = 0; i < alive; i++) s.addCreep(0, Const.KNIGHT, 1000 + 25 * (i % 20), 100 + 50 * (i / 20));
+        s.gold[0] = 1000;
+        Rules r = new Rules();
+        r.resolve(s, Command.waitCmd().train(4), Command.waitCmd());
+        assertEquals(s.barrTraining[4] ? 1000 - Const.CREEP_COST[Const.KNIGHT] : 1000, s.gold[0]);
+        if (!s.barrTraining[4]) assertEquals("Training too many creeps (" + (alive + 4) + " total units requested; 30 maximum)", r.lastWarning[0]);
+        return s.barrTraining[4];
+    }
+
+    @Test
+    void liveCreepLimit() {
+        assertTrue(trainAccepted(26), "26 + 4 = 30 is allowed");
+        assertFalse(trainAccepted(27), "27 + 4 = 31 is refused");
+    }
